{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Modes Config Schema",
  "type": "object",
  "required": ["schema_version", "modes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "max_candidates", "prioritize"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "max_candidates": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "prioritize": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
